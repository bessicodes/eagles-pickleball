# ------------------------------------------------------------------
# Eagles Pickleball — environment
# ------------------------------------------------------------------
# The app runs FULLY without these (it uses a built-in client engine).
# Fill these in only when you wire the real Supabase backend
# (supabase/schema.sql + supabase/seed.sql).
#
# Copy this file to `.env.local` and restart `npm run dev`.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Flip to "true" once Supabase is populated to switch the data layer
# from the local engine to live Supabase (adapter is stubbed & ready).
NEXT_PUBLIC_USE_SUPABASE=false

# Admin unlock PIN for the hidden /admin view.
NEXT_PUBLIC_ADMIN_PIN=2620
